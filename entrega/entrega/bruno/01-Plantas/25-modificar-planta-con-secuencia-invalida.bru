meta {
  name: Modificar planta con secuencia invalida
  type: http
  seq: 25
}

put {
  url: {{baseUrl}}/plantas/{{plantaId}}
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "{{nombreCientificoPlanta}}",
    "familiaBotanica": "Pruebaceae",
    "tipoCultivo": "hortaliza",
    "secuenciaGenetica": "ACGTX"
  }
}

assert {
  res.status: eq 400
}
