meta {
  name: Crear planta valida
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/plantas
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "Plantus bruno {{sufijo}}",
    "familiaBotanica": "Pruebaceae",
    "tipoCultivo": "hortaliza",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("sufijo", Date.now().toString());
}

script:post-response {
  bru.setVar("plantaId", res.body.id);
  bru.setVar("nombreCientificoPlanta", res.body.nombreCientifico);
}

tests {
  test("devuelve el id y los datos", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.secuenciaGenetica).to.equal("ATGCGTACGTTAGC");
  });
}
