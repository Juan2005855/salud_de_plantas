meta {
  name: Modificar cultivo con fecha futura
  type: http
  seq: 39
}

put {
  url: {{baseUrl}}/cultivos/{{cultivoId}}
  body: json
  auth: none
}

body:json {
  {
    "plantaId": {{plantaRefId}},
    "lote": "Lote de prueba",
    "region": "Boyaca",
    "fechaSiembra": "2999-01-01",
    "codigoGeneticoSemilla": "ATGCGTACGTTAGA"
  }
}

assert {
  res.status: eq 400
}
