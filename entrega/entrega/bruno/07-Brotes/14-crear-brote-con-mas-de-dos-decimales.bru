meta {
  name: Crear brote con mas de dos decimales
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/brotes
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 1,
    "enfermedadId": 1,
    "fecha": "2026-10-01",
    "region": "Boyaca",
    "hectareasAfectadas": 5.555
  }
}

assert {
  res.status: eq 400
}
