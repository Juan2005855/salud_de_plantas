meta {
  name: Crear brote valido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/brotes
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 1,
    "enfermedadId": 1,
    "fecha": "2026-10-01",
    "region": "Boyaca",
    "hectareasAfectadas": 5.5
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("broteNuevoId", res.body.id);
}

tests {
  test("devuelve el id y los datos", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.hectareasAfectadas).to.equal(5.5);
  });
}
