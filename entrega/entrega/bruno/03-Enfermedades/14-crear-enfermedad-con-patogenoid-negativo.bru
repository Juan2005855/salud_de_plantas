meta {
  name: Crear enfermedad con patogenoId negativo
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/enfermedades
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Enfermedad de prueba {{sufijoE}}",
    "descripcionSintomas": "Manchas en las hojas",
    "epocaRiesgo": "verano",
    "patogenoId": -1
  }
}

assert {
  res.status: eq 400
}
