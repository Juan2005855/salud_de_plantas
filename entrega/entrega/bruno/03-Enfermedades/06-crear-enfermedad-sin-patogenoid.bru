meta {
  name: Crear enfermedad sin patogenoId
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/enfermedades
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Enfermedad de prueba {{sufijoE}}",
    "descripcionSintomas": "Manchas en las hojas",
    "epocaRiesgo": "verano"
  }
}

assert {
  res.status: eq 400
}
