meta {
  name: No se elimina una enfermedad con brotes
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/enfermedades/{{enfermedadTmpId}}
  body: none
  auth: none
}

assert {
  res.status: in [400, 409]
}

tests {
  test("el mensaje explica el error", function () {
    const m = JSON.stringify(res.body.message).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    expect(m.includes("brote")).to.equal(true);
  });
}
