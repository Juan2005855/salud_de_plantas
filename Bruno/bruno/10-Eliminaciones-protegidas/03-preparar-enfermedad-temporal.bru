meta {
  name: Preparar enfermedad temporal
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/enfermedades
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Enfermedad temporal {{sufijoT}}",
    "descripcionSintomas": "Sintomas de prueba",
    "epocaRiesgo": "otoño",
    "patogenoId": {{patogenoTmpId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("enfermedadTmpId", res.body.id);
}
