meta {
  name: Crear susceptibilidad valida
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/susceptibilidades
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 9,
    "enfermedadId": 1,
    "nivel": "media"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("susceptibilidadNuevaId", res.body.id);
}

tests {
  test("devuelve el id y el nivel", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.nivel).to.equal("media");
  });
}
