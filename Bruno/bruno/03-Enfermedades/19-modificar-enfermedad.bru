meta {
  name: Modificar enfermedad
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/enfermedades/{{enfermedadNuevaId}}
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Enfermedad modificada {{sufijoE}}",
    "epocaRiesgo": "invierno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("cambia nombre y epoca", function () {
    expect(res.body.epocaRiesgo).to.equal("invierno");
  });
}
