meta {
  name: Crear enfermedad con epoca todo el anio
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/enfermedades
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Enfermedad anual {{sufijoE}}",
    "descripcionSintomas": "Manchas en las hojas",
    "epocaRiesgo": "todo_el_año",
    "patogenoId": 1
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("enfermedadAnualId", res.body.id);
}

tests {
  test("guarda la epoca todo_el_año", function () {
    expect(res.body.epocaRiesgo).to.equal("todo_el_año");
  });
}
