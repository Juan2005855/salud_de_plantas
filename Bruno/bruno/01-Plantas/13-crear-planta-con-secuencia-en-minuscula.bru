meta {
  name: Crear planta con secuencia en minuscula
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/plantas
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "Plantus s3 {{sufijo}}",
    "familiaBotanica": "Pruebaceae",
    "tipoCultivo": "hortaliza",
    "secuenciaGenetica": "atgcgtacgtta"
  }
}

assert {
  res.status: eq 400
}
