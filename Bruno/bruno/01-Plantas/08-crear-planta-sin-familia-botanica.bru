meta {
  name: Crear planta sin familia botanica
  type: http
  seq: 8
}

post {
  url: http://localhost:3000/plantas
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "Plantus otro {{sufijo}}",
    "tipoCultivo": "hortaliza",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 400
}
