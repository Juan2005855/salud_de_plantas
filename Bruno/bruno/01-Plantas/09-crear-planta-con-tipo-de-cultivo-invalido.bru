meta {
  name: Crear planta con tipo de cultivo invalido
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/plantas
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "Plantus tipo {{sufijo}}",
    "familiaBotanica": "Pruebaceae",
    "tipoCultivo": "arbol",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 400
}
