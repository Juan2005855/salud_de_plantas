meta {
  name: Modificar planta con nombre cientifico de otra
  type: http
  seq: 24
}

put {
  url: http://localhost:3000/plantas/{{plantaId}}
  body: json
  auth: none
}

body:json {
  {
    "nombreComun": "Planta de prueba",
    "nombreCientifico": "{{nombreCientificoPlanta2}}",
    "familiaBotanica": "Pruebaceae",
    "tipoCultivo": "hortaliza",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 409
}
