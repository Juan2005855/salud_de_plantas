meta {
  name: Listar plantas por nombre
  type: http
  seq: 18
}

get {
  url: http://localhost:3000/plantas?nombreComun=Planta de prueba
  body: none
  auth: none
}

params:query {
  nombreComun: Planta de prueba
}

assert {
  res.status: eq 200
}

tests {
  test("encuentra la planta creada", function () {
    expect(res.body.plantas.length).to.be.greaterThan(0);
  });
}
