meta {
  name: Listar brotes con varios filtros combinados
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/brotes?region=Antioquia&plantaId=2&enfermedadId=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("cumplen los tres filtros", function () {
    res.body.forEach(function (b) { expect(b.region).to.equal("Antioquia"); expect(b.plantaId).to.equal(2); expect(b.enfermedadId).to.equal(2); });
  });
}
