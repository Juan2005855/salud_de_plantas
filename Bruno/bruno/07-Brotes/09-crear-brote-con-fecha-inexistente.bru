meta {
  name: Crear brote con fecha inexistente
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/brotes
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 1,
    "enfermedadId": 1,
    "fecha": "2026-02-30",
    "region": "Boyaca",
    "hectareasAfectadas": 5.5
  }
}

assert {
  res.status: eq 400
}
