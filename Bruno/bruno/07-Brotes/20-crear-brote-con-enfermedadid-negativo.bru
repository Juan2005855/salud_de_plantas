meta {
  name: Crear brote con enfermedadId negativo
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/brotes
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 1,
    "enfermedadId": -1,
    "fecha": "2026-10-01",
    "region": "Boyaca",
    "hectareasAfectadas": 5.5
  }
}

assert {
  res.status: eq 400
}
