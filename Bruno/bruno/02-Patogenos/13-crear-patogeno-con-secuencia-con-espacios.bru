meta {
  name: Crear patogeno con secuencia con espacios
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/patogenos
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Patogeno de prueba",
    "nombreCientifico": "Pathogenus s2 {{sufijoP}}",
    "tipo": "hongo",
    "transmision": "viento",
    "secuenciaGenetica": "ATG CGT"
  }
}

assert {
  res.status: eq 400
}
