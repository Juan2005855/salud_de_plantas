meta {
  name: Consultar patogeno por id
  type: http
  seq: 17
}

get {
  url: http://localhost:3000/patogenos/{{patogenoNuevoId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve el patogeno creado", function () {
    expect(res.body.id).to.equal(bru.getVar("patogenoNuevoId"));
  });
}
