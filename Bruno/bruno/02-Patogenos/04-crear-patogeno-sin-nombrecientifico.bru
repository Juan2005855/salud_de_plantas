meta {
  name: Crear patogeno sin nombreCientifico
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/patogenos
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Patogeno de prueba",
    "tipo": "hongo",
    "transmision": "viento",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("el mensaje explica el error", function () {
    const m = JSON.stringify(res.body.message).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    expect(m.includes("nombrecientifico")).to.equal(true);
  });
}
