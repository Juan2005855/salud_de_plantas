meta {
  name: Crear patogeno valido
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/patogenos
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Patogeno de prueba",
    "nombreCientifico": "Pathogenus bruno {{sufijoP}}",
    "tipo": "hongo",
    "transmision": "viento",
    "secuenciaGenetica": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("sufijoP", Date.now().toString());
}

script:post-response {
  bru.setVar("patogenoNuevoId", res.body.id);
}

tests {
  test("devuelve el id y los datos", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.tipo).to.equal("hongo");
  });
}
