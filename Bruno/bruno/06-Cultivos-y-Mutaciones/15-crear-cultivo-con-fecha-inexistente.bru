meta {
  name: Crear cultivo con fecha inexistente
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/cultivos
  body: json
  auth: none
}

body:json {
  {
    "plantaId": {{plantaRefId}},
    "lote": "Lote de prueba",
    "region": "Boyaca",
    "fechaSiembra": "2026-02-31",
    "codigoGeneticoSemilla": "ATGCGTACGTTAGA"
  }
}

assert {
  res.status: eq 400
}
