meta {
  name: Crear cultivo con fecha futura
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/cultivos
  body: json
  auth: none
}

body:json {
  {
    "plantaId": {{plantaRefId}},
    "lote": "Lote de prueba",
    "region": "Boyaca",
    "fechaSiembra": "2999-01-01",
    "codigoGeneticoSemilla": "ATGCGTACGTTAGA"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("el mensaje menciona posterior", function () {
    expect(JSON.stringify(res.body.message).toLowerCase()).to.include("posterior");
  });
}
