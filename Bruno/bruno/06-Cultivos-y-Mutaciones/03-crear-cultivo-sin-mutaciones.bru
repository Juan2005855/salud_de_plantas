meta {
  name: Crear cultivo sin mutaciones
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/cultivos
  body: json
  auth: none
}

body:json {
  {
    "plantaId": {{plantaRefId}},
    "lote": "Lote de prueba",
    "region": "Boyaca",
    "fechaSiembra": "2026-03-15",
    "codigoGeneticoSemilla": "ATGCGTACGTTAGC"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cultivoIgualId", res.body.id);
}
