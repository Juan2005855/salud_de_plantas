meta {
  name: Crear cultivo con semilla en minuscula
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/cultivos
  body: json
  auth: none
}

body:json {
  {
    "plantaId": {{plantaRefId}},
    "lote": "Lote de prueba",
    "region": "Boyaca",
    "fechaSiembra": "2026-03-15",
    "codigoGeneticoSemilla": "atgcgtacgtta"
  }
}

assert {
  res.status: eq 400
}
