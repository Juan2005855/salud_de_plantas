meta {
  name: Verificar mutaciones del cultivo 5 con 0 mutaciones
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/cultivos/5/verificacion-mutaciones
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("cuenta 0 mutaciones", function () {
    expect(res.body.totalMutaciones).to.equal(0);
    expect(res.body.posicionesMutadas).to.eql([]);
  });
}
