meta {
  name: Verificar mutaciones del cultivo 2 con 2 mutaciones
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/cultivos/2/verificacion-mutaciones
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("cuenta 2 mutaciones", function () {
    expect(res.body.totalMutaciones).to.equal(2);
    expect(res.body.posicionesMutadas).to.eql([23, 32]);
  });
}
