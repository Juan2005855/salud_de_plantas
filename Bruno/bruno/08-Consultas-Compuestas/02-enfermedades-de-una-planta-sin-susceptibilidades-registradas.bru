meta {
  name: Enfermedades de una planta sin susceptibilidades registradas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/plantas/9/enfermedades
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve lista vacia", function () {
    expect(res.body.enfermedades).to.be.an("array");
  });
}
