meta {
  name: Verificar mutaciones del cultivo 3 con 1 mutaciones
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/cultivos/3/verificacion-mutaciones
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("cuenta 1 mutaciones", function () {
    expect(res.body.totalMutaciones).to.equal(1);
    expect(res.body.posicionesMutadas).to.eql([10]);
  });
}
