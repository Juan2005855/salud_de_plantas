meta {
  name: Modificar tratamiento
  type: http
  seq: 19
}

patch {
  url: http://localhost:3000/tratamientos/{{tratamientoNuevoId}}
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Tratamiento modificado",
    "tipo": "cultural"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("cambia nombre y tipo", function () {
    expect(res.body.tipo).to.equal("cultural");
  });
}
