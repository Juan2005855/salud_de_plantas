meta {
  name: Crear tratamiento con enfermedad inexistente
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/tratamientos
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Tratamiento de prueba",
    "descripcionAplicacion": "Aplicar cada semana",
    "tipo": "biologico",
    "enfermedadId": 99999
  }
}

assert {
  res.status: in [400, 404]
}

tests {
  test("el mensaje explica el error", function () {
    const m = JSON.stringify(res.body.message).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    expect(m.includes("enfermedad")).to.equal(true);
  });
}
